{
  "$schema": "../sdkwork-github-workflow/schemas/agent-workflow.schema.json",
  "schemaVersion": "2026-06-06.agent.workflow.v1",
  "app": {
    "id": "sdkwork-video",
    "name": "sdkwork-video",
    "repository": "sdkwork-ai/sdkwork-video",
    "sourcePath": ".",
    "configPath": "agent.app.config.json"
  },
  "release": {
    "artifactPrefix": "sdkwork-video",
    "defaultVersion": "0.1.0"
  },
  "dependencies": [
    {
      "id": "sdkwork-appbase",
      "repository": "sdkwork-ai/sdkwork-appbase",
      "refInput": "SDKWORK_APPBASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-assets",
      "repository": "sdkwork-ai/sdkwork-assets",
      "refInput": "SDKWORK_ASSETS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-audio",
      "repository": "sdkwork-ai/sdkwork-audio",
      "refInput": "SDKWORK_AUDIO_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-cloudrouter",
      "repository": "sdkwork-ai/sdkwork-cloudrouter",
      "refInput": "SDKWORK_CLOUDROUTER_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-core",
      "repository": "sdkwork-ai/sdkwork-core",
      "refInput": "SDKWORK_CORE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-database",
      "repository": "sdkwork-ai/sdkwork-database",
      "refInput": "SDKWORK_DATABASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-drive",
      "repository": "sdkwork-ai/sdkwork-drive",
      "refInput": "SDKWORK_DRIVE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-generations",
      "repository": "sdkwork-ai/sdkwork-generations",
      "refInput": "SDKWORK_GENERATIONS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-iam",
      "repository": "sdkwork-ai/sdkwork-iam",
      "refInput": "SDKWORK_IAM_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-id",
      "repository": "sdkwork-ai/sdkwork-id",
      "refInput": "SDKWORK_ID_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-image",
      "repository": "sdkwork-ai/sdkwork-image",
      "refInput": "SDKWORK_IMAGE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-models",
      "repository": "sdkwork-ai/sdkwork-models",
      "refInput": "SDKWORK_MODELS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-music",
      "repository": "sdkwork-ai/sdkwork-music",
      "refInput": "SDKWORK_MUSIC_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-sdk-commons",
      "repository": "sdkwork-ai/sdkwork-sdk-commons",
      "refInput": "SDKWORK_SDK_COMMONS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-ui",
      "repository": "sdkwork-ai/sdkwork-ui",
      "refInput": "SDKWORK_UI_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-utils",
      "repository": "sdkwork-ai/sdkwork-utils",
      "refInput": "SDKWORK_UTILS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-web-framework",
      "repository": "sdkwork-ai/sdkwork-web-framework",
      "refInput": "SDKWORK_WEB_FRAMEWORK_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    }
  ],
  "toolchains": {},
  "lifecycle": {},
  "targets": [
    {
      "id": "web-universal-cloud-browser-zip",
      "packageId": "web-universal-cloud-browser-zip",
      "profileBinding": "fixed",
      "deploymentProfile": "cloud",
      "runtimeTarget": "browser",
      "targetPlatform": "web",
      "clientArchitecture": "pc-web",
      "profile": "browser",
      "platform": "web",
      "architecture": "universal",
      "formats": [
        "zip"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/**"
      ]
    },
    {
      "id": "windows-x64-standalone-desktop-zip",
      "packageId": "windows-x64-standalone-desktop-zip",
      "profileBinding": "fixed",
      "deploymentProfile": "standalone",
      "runtimeTarget": "desktop",
      "targetPlatform": "windows",
      "clientArchitecture": "tauri",
      "profile": "desktop",
      "platform": "windows",
      "architecture": "x64",
      "formats": [
        "zip"
      ],
      "runner": "windows-2022",
      "outputGlobs": [
        "dist/**"
      ]
    },
    {
      "id": "macos-universal-standalone-desktop-dmg",
      "packageId": "macos-universal-standalone-desktop-dmg",
      "profileBinding": "fixed",
      "deploymentProfile": "standalone",
      "runtimeTarget": "desktop",
      "targetPlatform": "macos",
      "clientArchitecture": "tauri",
      "profile": "desktop",
      "platform": "macos",
      "architecture": "universal",
      "formats": [
        "dmg"
      ],
      "runner": "macos-14",
      "outputGlobs": [
        "dist/desktop/*.dmg"
      ]
    },
    {
      "id": "linux-x64-standalone-desktop-appimage",
      "packageId": "linux-x64-standalone-desktop-appimage",
      "profileBinding": "fixed",
      "deploymentProfile": "standalone",
      "runtimeTarget": "desktop",
      "targetPlatform": "linux",
      "clientArchitecture": "tauri",
      "profile": "desktop",
      "platform": "linux",
      "architecture": "x64",
      "formats": [
        "appimage"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/desktop/*.AppImage"
      ]
    }
  ],
  "security": {},
  "publish": {},
  "deployments": []
}
