# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema `sdkwork_video_demo` and a
# dedicated Redis logical DB index so no cache key collides with another shared-redis environment.
SDKWORK_VIDEO_DEPLOYMENT_PROFILE=cloud
SDKWORK_VIDEO_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_VIDEO_PROFILE_ID=cloud.demo
VITE_SDKWORK_VIDEO_DEPLOYMENT_PROFILE=cloud

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_VIDEO_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo public hosts (see topology.spec.json cloudPublicHosts environments["demo"]).
SDKWORK_VIDEO_APPLICATION_PUBLIC_HTTP_URL=https://video-demo.sdkwork.com
SDKWORK_VIDEO_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_VIDEO_APPLICATION_PUBLIC_HTTP_URL=https://video-demo.sdkwork.com

# Redis isolation: dedicate a logical DB index so hardcoded service prefixes never collide across environments.
SDKWORK_VIDEO_REDIS_URL=redis://127.0.0.1:6379/15
SDKWORK_VIDEO_REDIS_ENABLED=true
SDKWORK_CORS_ALLOWED_ORIGINS=https://video-demo.sdkwork.com,http://video-demo.sdkwork.com,https://video-demo.birdcoder.com,http://video-demo.birdcoder.com,https://video-demo.dtupay.com,http://video-demo.dtupay.com,https://video-demo.noaper.com,http://video-demo.noaper.com,https://video-demo.sdkwork.cn,http://video-demo.sdkwork.cn,https://video-demo.birdcoder.cn,http://video-demo.birdcoder.cn,https://video-demo.dtupay.cn,http://video-demo.dtupay.cn,https://video-demo.noaper.cn,http://video-demo.noaper.cn,https://video-demo.skubc.com,http://video-demo.skubc.com,https://video-demo.skubc.cn,http://video-demo.skubc.cn,https://video-demo.zowalk.com,http://video-demo.zowalk.com,https://video-demo.zowalk.cn,http://video-demo.zowalk.cn,https://video-demo.offer86.com,http://video-demo.offer86.com,https://video-demo.offer86.cn,http://video-demo.offer86.cn,https://video-demo.86offer.com,http://video-demo.86offer.com,https://video-demo.86offer.cn,http://video-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
