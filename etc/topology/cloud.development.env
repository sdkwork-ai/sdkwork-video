# Bootstrap profile cloud.development — replace with application-specific values.
SDKWORK_VIDEO_DEPLOYMENT_PROFILE=cloud
SDKWORK_VIDEO_ENVIRONMENT=development
SDKWORK_VIDEO_PROFILE_ID=cloud.development
SDKWORK_VIDEO_APPLICATION_PUBLIC_HTTP_URL=https://video-dev.sdkwork.com
SDKWORK_VIDEO_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_VIDEO_WEB_DEV_INGRESS_BIND=127.0.0.1:5575
SDKWORK_VIDEO_PC_INTERNAL_DEV_PORT=5577
SDKWORK_VIDEO_H5_INTERNAL_DEV_PORT=5578


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_VIDEO_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5575,http://localhost:5575,https://video-dev.sdkwork.com,http://video-dev.sdkwork.com,https://video-dev.birdcoder.com,http://video-dev.birdcoder.com,https://video-dev.dtupay.com,http://video-dev.dtupay.com,https://video-dev.noaper.com,http://video-dev.noaper.com,https://video-dev.sdkwork.cn,http://video-dev.sdkwork.cn,https://video-dev.birdcoder.cn,http://video-dev.birdcoder.cn,https://video-dev.dtupay.cn,http://video-dev.dtupay.cn,https://video-dev.noaper.cn,http://video-dev.noaper.cn,https://video-dev.skubc.com,http://video-dev.skubc.com,https://video-dev.skubc.cn,http://video-dev.skubc.cn,https://video-dev.zowalk.com,http://video-dev.zowalk.com,https://video-dev.zowalk.cn,http://video-dev.zowalk.cn,https://video-dev.offer86.com,http://video-dev.offer86.com,https://video-dev.offer86.cn,http://video-dev.offer86.cn,https://video-dev.86offer.com,http://video-dev.86offer.com,https://video-dev.86offer.cn,http://video-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
