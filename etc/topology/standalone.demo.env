# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema `sdkwork_video_demo` and a
# dedicated Redis logical DB index so no shared-redis cache key (rate-limit, session, idempotency)
# ever collides with another shared-redis environment.
SDKWORK_VIDEO_DEPLOYMENT_PROFILE=standalone
SDKWORK_VIDEO_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_VIDEO_PROFILE_ID=standalone.demo
VITE_SDKWORK_VIDEO_DEPLOYMENT_PROFILE=standalone

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_VIDEO_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo ingress bind/ports (kept apart from development 5575/5577/5578) so a meaningfully
# distinct origin can be published externally for system demonstrations.
SDKWORK_VIDEO_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18075
SDKWORK_VIDEO_APPLICATION_PUBLIC_HTTP_URL=http://video-demo.sdkwork.com:18075
SDKWORK_VIDEO_WEB_DEV_INGRESS_BIND=0.0.0.0:18075
SDKWORK_VIDEO_PC_INTERNAL_DEV_PORT=5577
SDKWORK_VIDEO_H5_INTERNAL_DEV_PORT=5578
VITE_SDKWORK_VIDEO_APPLICATION_PUBLIC_HTTP_URL=http://video-demo.sdkwork.com:18075

# Redis isolation: point the demo at a dedicated logical DB index on the shared Redis so hardcoded
# service prefixes remain confined to this environment and can never collide with dev/test/staging/prod.
SDKWORK_VIDEO_REDIS_URL=redis://127.0.0.1:6379/15
SDKWORK_VIDEO_REDIS_ENABLED=true
