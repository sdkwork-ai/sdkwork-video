# Bootstrap profile standalone.production — replace with application-specific values.
SDKWORK_VIDEO_DEPLOYMENT_PROFILE=standalone
SDKWORK_VIDEO_ENVIRONMENT=production
SDKWORK_VIDEO_PROFILE_ID=standalone.production
SDKWORK_VIDEO_APPLICATION_PUBLIC_HTTP_URL=https://video.sdkwork.com
SDKWORK_VIDEO_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900
SDKWORK_VIDEO_PC_STATIC_ROOT=/usr/share/sdkwork/video/web/pc


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_VIDEO_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://video.sdkwork.com,https://video.birdcoder.com,https://video.dtupay.com,https://video.noaper.com,https://video.sdkwork.cn,https://video.birdcoder.cn,https://video.dtupay.cn,https://video.noaper.cn,https://video.skubc.com,https://video.skubc.cn,https://video.zowalk.com,https://video.zowalk.cn,https://video.offer86.com,https://video.offer86.cn,https://video.86offer.com,https://video.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
